[submodule "platform/external/turbine"]
	branch = metalava-main
	path = external/turbine
	url = ../external/turbine
[submodule "platform/prebuilts/jdk/jdk21"]
	branch = main
	shallow = true
	path = prebuilts/jdk/jdk21
	url = ../prebuilts/jdk/jdk21
[submodule "platform/prebuilts/metalava"]
	branch = metalava-main
	shallow = true
	path = prebuilts/metalava
	url = ../prebuilts/metalava
[submodule "platform/prebuilts/tools"]
	branch = main
	shallow = true
	path = prebuilts/tools
	url = ../prebuilts/tools
[submodule "platform/tools/external/gradle"]
	branch = androidx-main
	shallow = true
	path = tools/external/gradle
	url = ../tools/external/gradle
[submodule "platform/tools/metalava"]
	branch = metalava-main
	path = tools/metalava
	url = ../tools/metalava
[submodule "platform/tools/repohooks"]
	branch = main
	path = tools/repohooks
	url = ../tools/repohooks
